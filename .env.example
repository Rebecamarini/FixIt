# Somente servidor. Copie para .env.local. Selecione explicitamente local ou cloud.
SUPABASE_TARGET=local
SUPABASE_URL=http://127.0.0.1:54321
# Use Publishable key ou anon key de npm run supabase:status.
# Neste campo use somente chave pública; a capacidade restrita está descrita abaixo.
SUPABASE_PUBLISHABLE_KEY=

# Cloud compartilhado: SUPABASE_TARGET=cloud
# SUPABASE_URL=https://gifqssocvuieagmndxwy.supabase.co
# Obtenha a Publishable key desse projeto com acesso pessoal no painel.
# Não use o URL cloud com SUPABASE_TARGET=local ou vice-versa.

# US-003/004: somente servidor, para trocar o próprio e-mail e gerir contas como Gestor.
# Nunca use NEXT_PUBLIC_ e nunca substitua SUPABASE_PUBLISHABLE_KEY por esta chave.
SUPABASE_SECRET_KEY=
