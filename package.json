{
  "name": "fixit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.18.0", "npm": "11.16.0" },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --test --test-isolation=none tests/*.test.ts",
    "test:integration": "node --conditions=react-server --test --test-isolation=none tests/*.integration.ts",
    "check:connection": "node --conditions=react-server scripts/check-connection.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "supabase": "2.121.0",
    "typescript": "5.9.3"
  }
}
