{
  "name": "fixit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --test --test-isolation=none tests/*.test.ts",
    "test:integration": "node --conditions=react-server --test --test-isolation=none tests/*.integration.ts",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:integration",
    "check:connection": "node --conditions=react-server scripts/check-connection.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "prepare:test-data": "node --conditions=react-server scripts/prepare-test-data.ts",
    "check:duplicates": "jscpd src --config .jscpd.json",
    "check:dependencies": "depcruise src --config .dependency-cruiser.cjs --output-type err && depcruise src --config .dependency-cruiser.cjs --metrics --output-type metrics",
    "check:unused": "knip --no-progress",
    "check:static": "npm run lint && npm run check:duplicates && npm run check:dependencies && npm run check:unused"
  },
  "dependencies": {
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.108.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "jscpd": "5.4.2",
    "knip": "6.42.1",
    "supabase": "2.121.0",
    "typescript": "5.9.3"
  }
}
